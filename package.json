{
  "name": "deterministic-nonce-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static site that verifies an airgapped QR Bitcoin signer uses a deterministic ECDSA nonce",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:embit": "make test",
    "gen:cases": "tsx embit-test-harness/generate_cases.mts",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "build:all": "node scripts/build-all.mjs"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@ngraveio/bc-ur": "1.1.13",
    "@noble/curves": "1.9.7",
    "bip32": "4.0.0",
    "bip39": "3.1.0",
    "bitcoinjs-lib": "6.1.7",
    "buffer": "6.0.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "2.1.9"
  }
}
